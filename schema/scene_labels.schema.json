{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bim-database.local/schema/scene_labels.schema.json",
  "title": "SceneLabels",
  "description": "Annotation layer for one technical-drawing scene. The labels are stored in pixel coordinates of the ORIGINAL image; the homography that rectifies the image is computed from the dimensioned_distance labels with is_reference=true and used at export time to derive the rectified ground truth.",
  "type": "object",
  "required": ["schema_version", "scene_key", "scene_file", "scene_tag", "image_size_px", "labels"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Bumped on breaking changes. Migrations live in scripts/migrate_labels.py."
    },
    "scope": {
      "type": "string",
      "enum": ["dataset", "house"],
      "description": "Which side of the database this scene belongs to. 'dataset' = the supervised-learning corpus under data/dataset/ (mix of AI-generated + real). 'house' = the source catalog under data/houses/. Optional — defaults to dataset if the key has no real-house counterpart."
    },
    "scene_key": {
      "type": "string",
      "description": "House key, e.g. 'house-1'."
    },
    "scene_file": {
      "type": "string",
      "description": "Filename of the scene image, e.g. 'house-1-syn-floorplan-eg.png'."
    },
    "scene_tag": {
      "type": "string",
      "enum": ["grundriss", "ansicht", "schnitt", "sonstiges", "nicht_klassifiziert"],
      "description": "Determines which label tools are available."
    },
    "scene_orientation": {
      "type": ["string", "null"],
      "enum": ["north", "south", "east", "west", null],
      "description": "N6: for ansicht/schnitt — which building face this scene shows. Scopes cross-scene caches: Nordansicht's values only pre-fill future Nordansichten."
    },
    "scene_level": {
      "type": ["string", "null"],
      "enum": ["kg", "ug", "eg", "og", "dg", "spitzboden", null],
      "description": "N6: for grundriss — which floor this scene shows. Scopes cross-scene caches: EG's values only pre-fill future EG floorplans."
    },
    "image_size_px": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1},
      "minItems": 2,
      "maxItems": 2,
      "description": "[width, height] in pixels of the original image."
    },
    "annotated_by": {
      "type": "string",
      "description": "Static placeholder for now (single-user). Future multi-user systems can swap this for an account id."
    },
    "annotated_at": {
      "type": "string",
      "format": "date-time"
    },
    "labels": {
      "type": "array",
      "items": {"$ref": "#/$defs/Label"}
    },
    "homography": {
      "$ref": "#/$defs/Homography",
      "description": "Derived field — re-computed from labels with is_reference=true. Stored only so exports are reproducible."
    },
    "anomalies": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Short human-readable strings surfacing consistency issues (e.g. dimension_number text doesn't match linked distance.value_mm)."
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hidden_label_ids": {
          "type": "array",
          "items": {"type": "string"},
          "description": "W7: per-scene display preference — label ids that exist in the JSON but should not render on the canvas (e.g. inherited Höhenkoten that aren't useful in this view)."
        }
      },
      "description": "W7: per-scene display preferences (visibility toggles). Stays orthogonal to the label data — hidden ≠ deleted."
    }
  },
  "$defs": {
    "Point": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 2,
      "maxItems": 2,
      "description": "[x, y] in pixel coordinates of the original image."
    },
    "Polyline": {
      "type": "array",
      "items": {"$ref": "#/$defs/Point"},
      "minItems": 2
    },
    "Quad": {
      "type": "array",
      "items": {"$ref": "#/$defs/Point"},
      "minItems": 4,
      "maxItems": 4,
      "description": "Oriented rectangle as 4 corner points (so it transforms correctly under a homography)."
    },
    "LabelStatus": {
      "type": "string",
      "enum": ["readable", "not_readable", "missing", "uncertain"],
      "description": "Honesty axis — see §4.1 of spec/annotation-tool.md."
    },
    "Relation": {
      "type": "object",
      "required": ["other_id", "kind"],
      "additionalProperties": false,
      "properties": {
        "other_id": {"type": "string", "description": "Another label's id."},
        "kind": {
          "type": "string",
          "enum": ["labels", "belongs_to", "references"],
          "description": "Relation semantics: 'labels' = this is a dimension_number that labels another label; 'belongs_to' = part of a group; 'references' = generic pointer."
        }
      }
    },
    "LabelEnvelope": {
      "type": "object",
      "required": ["id", "type", "geometry", "status"],
      "properties": {
        "id": {"type": "string", "description": "UUID v4."},
        "type": {"type": "string"},
        "geometry": {"type": "object"},
        "attributes": {"type": "object"},
        "status": {"$ref": "#/$defs/LabelStatus"},
        "source": {"type": "string"},
        "relations": {"type": "array", "items": {"$ref": "#/$defs/Relation"}},
        "notes": {"type": "string"},
        "run_id": {"type": ["string", "null"]},
        "agent_id": {"type": ["string", "null"]},
        "subagent_id": {"type": ["string", "null"]},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "Label": {
      "oneOf": [
        {"$ref": "#/$defs/WallLabel"},
        {"$ref": "#/$defs/FloorplanOpeningLabel"},
        {"$ref": "#/$defs/ViewOpeningLabel"},
        {"$ref": "#/$defs/ComponentLineLabel"},
        {"$ref": "#/$defs/HeightMarkLabel"},
        {"$ref": "#/$defs/DimensionedDistanceLabel"},
        {"$ref": "#/$defs/DimensionNumberLabel"}
      ]
    },
    "WallLabel": {
      "allOf": [{"$ref": "#/$defs/LabelEnvelope"}, {
        "properties": {
          "type": {"const": "wall"},
          "geometry": {
            "type": "object",
            "required": ["start", "end"],
            "additionalProperties": false,
            "properties": {
              "start": {"$ref": "#/$defs/Point"},
              "end": {"$ref": "#/$defs/Point"}
            }
          },
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "thickness_mm": {"type": ["number", "null"]},
              "anchoring_required": {"type": "boolean"},
              "mass_id": {"type": "string"},
              "mass_kind": {
                "type": "string",
                "enum": ["main_house", "detached_garage", "projection", "wing", "other"]
              },
              "mass_mode": {
                "type": "string",
                "enum": ["structural_confirmed", "structural_uncertain", "projection_non_wall", "partial_mass_hypothesis"]
              },
              "mass_tool": {
                "type": "string",
                "enum": ["upsert_rect_mass", "upsert_stepped_mass", "upsert_wall_system"]
              },
              "mass_edge_index": {"type": "integer", "minimum": 0},
              "mass_edge_count": {"type": "integer", "minimum": 1},
              "mass_role": {
                "type": "string",
                "enum": ["exterior", "interior", "detail"]
              },
              "edge_confidence": {"type": ["number", "null"]},
              "endpoint_reason_start": {
                "type": "string",
                "enum": ["corner", "t_junction", "real_endpoint", "separate_mass_boundary", "mass_corner", "uncertain", "missing"]
              },
              "endpoint_reason_end": {
                "type": "string",
                "enum": ["corner", "t_junction", "real_endpoint", "separate_mass_boundary", "mass_corner", "uncertain", "missing"]
              },
              "quality_status": {
                "type": "string",
                "enum": ["ink_anchored", "centerline_plausible", "off_ink", "unanchored", "uncertain"]
              },
              "confidence_reason": {"type": "string"},
              "quality_reason": {"type": "string"},
              "uncertainty_reason": {"type": "string"},
              "review_required": {"type": "boolean"},
              "centerline_review": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "method": {"type": "string"},
                  "decision": {
                    "type": "string",
                    "enum": ["centerline_plausible", "rejected"]
                  },
                  "confidence": {
                    "type": "string",
                    "enum": ["low", "medium", "high"]
                  },
                  "review_region": {
                    "type": "array",
                    "items": {"type": "number"},
                    "minItems": 4,
                    "maxItems": 4
                  },
                  "rail_evidence": {
                    "type": "array",
                    "items": {"type": "string"}
                  },
                  "reason": {"type": "string"},
                  "previous_quality_status": {
                    "type": ["string", "null"],
                    "enum": ["ink_anchored", "centerline_plausible", "off_ink", "unanchored", "uncertain", null]
                  }
                }
              },
              "detail_mode": {
                "type": "string",
                "enum": ["detail_refinement", "mass_exception", "repair_candidate"]
              },
              "anchoring": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "method": {"type": "string"},
                  "confidence": {"type": ["number", "null"]},
                  "ink_overlap": {"type": ["number", "null"]},
                  "original_start": {"$ref": "#/$defs/Point"},
                  "original_end": {"$ref": "#/$defs/Point"},
                  "delta_px": {
                    "type": "array",
                    "items": {"type": "number"},
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "evidence_id": {"type": ["string", "null"]}
                }
              }
            }
          }
        }
      }]
    },
    "FloorplanOpeningLabel": {
      "allOf": [{"$ref": "#/$defs/LabelEnvelope"}, {
        "properties": {
          "type": {"const": "floorplan_opening"},
          "geometry": {
            "type": "object",
            "required": ["quad"],
            "additionalProperties": false,
            "properties": {"quad": {"$ref": "#/$defs/Quad"}}
          },
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "opening_kind": {"type": "string", "enum": ["door", "window", "passage", "garage_door", "other"]},
              "width_mm": {"type": ["number", "null"]},
              "swing": {"type": "string", "enum": ["in", "out", "sliding", "none"]},
              "swing_side": {"type": "string", "enum": ["left", "right", "none"]},
              "transaction_id": {"type": "string"},
              "source_candidate_id": {"type": "string"},
              "source_candidate_fingerprint": {"type": "string"},
              "parent_wall_id": {"type": "string"},
              "parent_wall_quality_status": {
                "type": ["string", "null"],
                "enum": ["ink_anchored", "centerline_plausible", "off_ink", "unanchored", "uncertain", null]
              },
              "opening_axis": {"$ref": "#/$defs/Polyline"},
              "qa_status": {"type": "string", "enum": ["passed", "failed", "needs_review"]},
              "parent_wall_verification": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "parent_wall_id": {"type": "string"},
                  "quality_status": {
                    "type": ["string", "null"],
                    "enum": ["ink_anchored", "centerline_plausible", "off_ink", "unanchored", "uncertain", null]
                  },
                  "local_qa_ok": {"type": "boolean"}
                }
              }
            }
          }
        }
      }]
    },
    "ViewOpeningLabel": {
      "allOf": [{"$ref": "#/$defs/LabelEnvelope"}, {
        "properties": {
          "type": {"const": "view_opening"},
          "geometry": {
            "oneOf": [
              {
                "type": "object",
                "required": ["top_edge", "bottom_edge"],
                "additionalProperties": false,
                "properties": {
                  "top_edge": {"$ref": "#/$defs/Polyline"},
                  "bottom_edge": {"$ref": "#/$defs/Polyline"}
                }
              },
              {
                "type": "object",
                "description": "Circle / round window. center + radius in image px.",
                "required": ["shape", "center", "radius_px"],
                "additionalProperties": false,
                "properties": {
                  "shape": {"const": "circle"},
                  "center": {"$ref": "#/$defs/Point"},
                  "radius_px": {"type": "number", "exclusiveMinimum": 0}
                }
              },
              {
                "type": "object",
                "description": "Arbitrary polygon for arched / pointed / irregular openings.",
                "required": ["shape", "polygon"],
                "additionalProperties": false,
                "properties": {
                  "shape": {"const": "polygon"},
                  "polygon": {"$ref": "#/$defs/Polyline"}
                }
              }
            ]
          },
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "opening_kind": {"type": "string", "enum": ["door", "window", "skylight", "dormer", "garage_door", "other"]},
              "frame_visible": {"type": "boolean"}
            }
          }
        }
      }]
    },
    "ComponentLineLabel": {
      "allOf": [{"$ref": "#/$defs/LabelEnvelope"}, {
        "properties": {
          "type": {"const": "component_line"},
          "geometry": {
            "type": "object",
            "required": ["polyline"],
            "additionalProperties": false,
            "properties": {"polyline": {"$ref": "#/$defs/Polyline"}}
          },
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "line_kind": {"type": "string", "enum": [
                "first", "traufe", "gelaende", "geschoss", "ok_ffb",
                "sockel", "firstkante", "dachschraege", "kniestock",
                "gebaeudekante", "other"
              ]}
            }
          }
        }
      }]
    },
    "HeightMarkLabel": {
      "allOf": [{"$ref": "#/$defs/LabelEnvelope"}, {
        "properties": {
          "type": {"const": "height_mark"},
          "geometry": {
            "type": "object",
            "required": ["anchor"],
            "additionalProperties": false,
            "properties": {"anchor": {"$ref": "#/$defs/Point"}}
          },
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value_mm": {"type": ["number", "null"]},
              "datum": {
                "type": ["string", "null"],
                "enum": ["first", "traufe", "gelaende", "geschoss", "ok_ffb", "sockel", "kniestock", "bezug", "other", null],
                "description": "which named height-datum this Höhenkote represents (First, Traufe, Gelände, Bezug/±0.00, …). Drives the training signal — a Höhenkote with datum='first' tells the model 'this value IS the Firsthöhe'."
              },
              "reference_line_id": {"type": ["string", "null"], "description": "(legacy) id of a component_line this height is measured from"}
            }
          }
        }
      }]
    },
    "DimensionedDistanceLabel": {
      "allOf": [{"$ref": "#/$defs/LabelEnvelope"}, {
        "properties": {
          "type": {"const": "dimensioned_distance"},
          "geometry": {
            "type": "object",
            "required": ["start", "end"],
            "additionalProperties": false,
            "properties": {
              "start": {"$ref": "#/$defs/Point"},
              "end": {"$ref": "#/$defs/Point"}
            }
          },
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target_orientation", "is_reference"],
            "properties": {
              "value_mm": {"type": ["number", "null"]},
              "target_orientation": {
                "oneOf": [
                  {"type": "string", "enum": ["horizontal", "vertical", "unknown"]},
                  {"type": "string", "pattern": "^angle_deg:-?[0-9]+(\\.[0-9]+)?$"}
                ]
              },
              "is_reference": {
                "type": "boolean",
                "description": "Anchors the homography computation. Strokes with this true + a value_mm are what model 1 must detect."
              },
              "dimension_semantic": {
                "type": "string",
                "enum": ["building", "site_setback", "elevation_datum", "unknown"]
              },
              "calibration_role": {
                "type": "string",
                "enum": ["none", "building_metric", "site_metric", "transferred", "assumed_isotropic"]
              },
              "calibration_confidence": {
                "type": "string",
                "enum": ["low", "medium", "high"]
              },
              "reference_review": {"type": "string"},
              "reference_review_evidence_ids": {
                "type": "array",
                "items": {"type": "string"}
              },
              "transaction_id": {"type": "string"},
              "span_id": {"type": "string"},
              "chain_id": {"type": "string"},
              "station_ids": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          }
        }
      }]
    },
    "DimensionNumberLabel": {
      "allOf": [{"$ref": "#/$defs/LabelEnvelope"}, {
        "properties": {
          "type": {"const": "dimension_number"},
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "anchor": {"$ref": "#/$defs/Point"},
              "bbox": {"$ref": "#/$defs/Quad"}
            },
            "anyOf": [
              {"required": ["anchor"]},
              {"required": ["bbox"]}
            ]
          },
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": {"type": "string", "description": "As-written, e.g. '1,75'."},
              "parsed_value_mm": {"type": ["number", "null"]}
            }
          }
        }
      }]
    },
    "Homography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matrix": {
          "type": "array",
          "items": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
          "minItems": 3,
          "maxItems": 3,
          "description": "3x3 row-major. Multiplied by [x_px, y_px, 1]^T gives rectified pixel coords."
        },
        "computed_from": {
          "type": "array",
          "items": {"type": "string"},
          "description": "ids of the dimensioned_distance labels used."
        },
        "rectified_size_px": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1},
          "minItems": 2,
          "maxItems": 2
        },
        "rms_residual_px": {"type": "number"},
        "status": {
          "type": "string",
          "enum": ["ok", "insufficient_references", "degenerate"],
          "description": "Why the matrix may be missing."
        }
      }
    }
  }
}
